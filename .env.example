# --- CurseForge access -------------------------------------------------------
# Recommended for production: point the app at a proxy that injects the
# `x-api-key` header server-side (see proxy/cloudflare-worker.js). When this is
# set, the browser never sees the key.
VITE_CURSEFORGE_PROXY_URL=

# Development only: a key placed here is compiled into the JS bundle and is
# readable by anyone who loads the page. Never deploy a build made with it.
VITE_CURSEFORGE_API_KEY=
